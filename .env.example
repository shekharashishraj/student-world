# Copy this file to .env and fill in your values

# Secret key for LTI JWT signing (minimum 32 characters, keep this random and private)
LTI_KEY=STUDENT_WORLD_DEV_KEY_MIN32CHARSLONG!!

# Canvas LTI 1.3 Client ID (get this from Canvas after registering the tool)
LTI_CLIENT_ID=

# Your Canvas instance URL
CANVAS_URL=https://asu.instructure.com

# Postgres configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=student_world
POSTGRES_USER=student_world
POSTGRES_PASSWORD=student_world

# OpenAI API configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1-2025-11-13
OPENAI_REASONING_EFFORT=none

# Logging
LOG_LEVEL=debug

# Frontend development origin
WEB_DEV_ORIGIN=http://localhost:5173

# Public app URL used for production redirects
APP_URL=http://localhost:3000

# Set to 'production' when deploying
NODE_ENV=development

# Server port (default 3000)
PORT=3000
