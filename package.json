{
  "name": "student-world",
  "version": "1.0.0",
  "description": "A 3D world map connecting students globally",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@babylonjs/core": "^8.55.1",
    "@babylonjs/loaders": "^8.55.1",
    "@babylonjs/materials": "^8.55.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "ltijs": "^5.9.9",
    "ltijs-sequelize": "^2.4.4",
    "openai": "^6.29.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sequelize": "^6.37.8",
    "socket.io": "^4.7.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "nodemon": "^3.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
